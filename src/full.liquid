<div class="layout nl-news layout--col layout--top text p--0 gap--none">

  <div class="absolute p--5" style="top: 0; left: 0; z-index: 10;">
    <img class="w--16" src="
      {% if feed contains "nos_" %}
    https://trmnl.achtnegen.nl/rss/logos/nos_white.svg
    {% elsif feed contains "nu_" %}
    https://trmnl.achtnegen.nl/rss/logos/nu_white.svg
    {% elsif feed contains "ad_" %}
    https://trmnl.achtnegen.nl/rss/logos/ad_white.svg
    {% elsif feed contains "rtl_" %}
    https://trmnl.achtnegen.nl/rss/logos/rtl_white.svg
    {% endif %}">
  </div>

  <div class="grid grid--cols-2 gap--none">
    {% for item in rss.channel.item limit:2 %}
    {% assign thumb = item.enclosure.url | default: item.content.thumbnail.url %}
    <div class="flex flex--col flex--left h--full flex--top relative">
      {% if thumb %}
      <img class="w--full image-dither aspect--3/2 lg:aspect--4/3 image image--cover" src="{{ thumb }}">
      {% endif %}
      <div class="absolute news-title p--6 pt--10">
        <div class="text text--base font--bold text--gray-70 mb--1">
          {{ item.pubDate | date: "%s" | plus: tz_offset | date: "%H:%M" }}
        </div>
        <h2 class="text text--large lg:text--xlarge text--white">
          {{ item.title }}
        </h2>
      </div>
    </div>
    {% endfor %}
  </div>

  <div class="lg:hidden w--full flex flex--col flex--left h--full p--3">
    {% for item in rss.channel.item offset:2 limit:6 %}
    <div class="flex value--xsmall gap--medium w--full h--full">
      <div class="flex flex--col flex--left gap--none stretch">
        <h2 class="w--full text text--base lg:text--base flex flex--center-y">
          <span class="value--xxsmall text--gray-30 w--10">
            {{ item.pubDate | date: "%s" | plus: tz_offset | date: "%H:%M" }}
          </span>
          <span class="w--full" data-clamp="1">
            {{ item.title }}
          </span>
        </h2>
      </div>
    </div>
    {% endfor %}
  </div>

  <div class="md:hidden lg:portrait:hidden lg:flex w--full flex flex--col flex--left h--full p--2">
    {% for item in rss.channel.item offset:2 limit:5 %}
    {% assign thumb = item.enclosure.url | default: item.content.thumbnail.url %}
    <div class="flex value--xsmall gap--medium w--full h--full">
      {% if thumb %}
      <img class="w--24 image-dither rounded--xsmall image image--cover" src="{{ thumb }}">
      {% endif %}
      <div class="flex flex--col flex--left gap--none stretch">
        <span class="text--gray-30 text text--base font--bold text--gray-40">
          {{ item.pubDate | date: "%s" | plus: tz_offset | date: "%H:%M" }}
        </span>
        <span class="w--full text text--base lg:text--base" data-clamp="1">
          {{ item.title }}
        </span>
      </div>
    </div>
    {% endfor %}
  </div>

  <div class="md:hidden lg:portrait:flex w--full flex flex--col flex--left h--full p--2">
    {% for item in rss.channel.item offset:2 limit:10 %}
    {% assign thumb = item.enclosure.url | default: item.content.thumbnail.url %}
    <div class="flex value--xsmall gap--medium w--full h--full">
      {% if thumb %}
      <img class="w--24 image-dither rounded--xsmall image image--cover" src="{{ thumb }}">
      {% endif %}
      <div class="flex flex--col flex--left gap--none stretch">
        <span class="text--gray-30 text text--base font--bold text--gray-40">
          {{ item.pubDate | date: "%s" | plus: tz_offset | date: "%H:%M" }}
        </span>
        <span class="w--full text text--base lg:text--base" data-clamp="1">
          {{ item.title }}
        </span>
      </div>
    </div>
    {% endfor %}
  </div>

</div>