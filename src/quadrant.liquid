  </div>
  <div class="w--full flex--col flex lg:hidden">
    {% for item in rss.channel.item offset:1 limit:6 %}
    <div class="flex value--xsmall gap--medium w--full h--full">
      <div class="flex flex--col flex--left gap--none stretch">
        <h2 class="w--full text text--base lg:text--base flex flex--center-y">
          <span class="value--xxsmall text--gray-30 w--12">
            {{ item.pubDate | date: "%H:%M" | downcase }}
          </span>
          <span class="w--full" data-clamp="1">
            {{ item.title }}
          </span>
        </h2>
      </div>
    </div>
    {% endfor %}
  </div>

  <div class="md:hidden lg:flex w--full flex flex--col flex--left h--full p--2">
    {% for item in rss.channel.item offset:2 limit:5 %}
    {% assign thumb = item.enclosure.url | default: item.content.thumbnail.url %}
    <div class="flex value--xsmall gap--medium w--full h--full">
      {% if thumb %}
      <img class="w--24 image-dither rounded--xsmall image image--cover" src="{{ thumb }}">
      {% endif %}
      <div class="flex flex--col flex--left gap--none stretch">
        <span class="text--gray-30 text text--base font--bold text--gray-40">
          {{ item.pubDate | date: "%H:%M" | downcase }}
        </span>
        <span class="w--full text text--base lg:text--base" data-clamp="1">
          {{ item.title }}
        </span>
      </div>
    </div>
    {% endfor %}
  </div>

</div>